# backend/.env

# Application Settings
PROJECT_NAME="AI-Powered Tender Compliance Verification Platform"
VERSION="1.0.0"
ENVIRONMENT="development"

# Database Configuration
DATABASE_URL="sqlite:///./tender_platform.db"

# Security & Authentication (JWT)
# In production, replace this with a random 32+ character string
SECRET_KEY="sih-26100-super-secret-jwt-key-replace-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Rate Limiting & Lockout Rules
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=2

# CORS (Cross-Origin Resource Sharing)
# This allows your React (Vite) frontend running on port 5173 to communicate with the backend
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"